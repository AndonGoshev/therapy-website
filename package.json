{
  "name": "therapy-website",
  "version": "1.0.0",
  "description": "Personal therapy website built with Eleventy and Tailwind CSS",
  "homepage": "https://andongoshev.github.io/therapy-website",

  "scripts": {
    "start": "npx eleventy --serve & npx tailwindcss -i ./src/css/tailwind.css -o ./_site/css/styles.css --watch",
    "build": "eleventy",
    "deploy": "gh-pages -d _site",
    "clean": "rimraf _site"
  },
  "keywords": [
    "therapy",
    "eleventy",
    "tailwindcss",
    "bulgarian"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-navigation": "^0.3.5",
    "autoprefixer": "^10.4.16",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.32",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.0"
  }
}